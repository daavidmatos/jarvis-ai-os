APP_ENV=development
DATABASE_URL=sqlite:///./jarvis.db
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:8000

# Optional environment override. Normal local setup is done once through the JARVIS UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
PRIMARY_PROVIDER=openai

# Optional specialist AIs. When configured, JARVIS may delegate automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Google Workspace OAuth (Gmail + Calendar). Separate from GOOGLE_API_KEY/Gemini.
# Create a Google OAuth Web Application and register:
#   http://localhost:8000/v1/integrations/google/callback   (local tests)
#   https://your-jarvis-domain/v1/integrations/google/callback (hosted)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_PATH=~/.config/jarvis/google_oauth.json
GOOGLE_MONITOR_STATE_PATH=~/.config/jarvis/google_monitor.json

# Gmail continuous monitoring uses Gmail users.watch -> Google Cloud Pub/Sub.
# Example: projects/my-google-cloud-project/topics/jarvis-gmail
GMAIL_PUBSUB_TOPIC=
# Add ?token=<this value> to the Pub/Sub push subscription endpoint.
GOOGLE_PUBSUB_WEBHOOK_SECRET=
ENABLE_GOOGLE_MONITORING=true
GOOGLE_MONITOR_INTERVAL_SECONDS=43200

# Optional dedicated search providers. OpenAI hosted web search is the default fallback.
TAVILY_API_KEY=
SERPER_API_KEY=

SECRETS_PATH=~/.config/jarvis/secrets.json
AUTONOMOUS_ROUTING=true
ALLOW_EXTERNAL_AI=true
ALLOW_LOCAL_FALLBACK=false
FINALIZE_WITH_PRIMARY=true
MAX_AGENT_STEPS=5
MAX_TASK_RETRIES=2
MAX_PLAN_TASKS=8
WORKSPACE_DIR=./workspace
ENABLE_AUTONOMY=true
ALLOW_MEDIUM_RISK_TOOLS=true

APP_ENV=development
DATABASE_URL=sqlite:///./jarvis.db
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:8000

# Configure OpenAI once through the JARVIS UI or as a server secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
PRIMARY_PROVIDER=openai

# Optional specialist AIs. JARVIS routes to them automatically when useful.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Google Workspace OAuth: Gmail + Calendar + Google Ads + Docs/Sheets scopes.
# Reconnect Google after adding new scopes so the refresh token grants them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_PATH=~/.config/jarvis/google_oauth.json
GOOGLE_MONITOR_STATE_PATH=~/.config/jarvis/google_monitor.json
GMAIL_PUBSUB_TOPIC=
GOOGLE_PUBSUB_WEBHOOK_SECRET=
ENABLE_GOOGLE_MONITORING=true
GOOGLE_MONITOR_INTERVAL_SECONDS=3600

# Google Maps Platform / Places API (New). Server-side only.
GOOGLE_MAPS_API_KEY=
PLACES_DEFAULT_RADIUS_M=5000
PLACES_MAX_CANDIDATES=5

# Google Ads API. Developer token is required in addition to Google OAuth.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# Meta / Instagram Graph API.
META_GRAPH_VERSION=v24.0
META_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Trello collaboration connector.
TRELLO_API_KEY=
TRELLO_TOKEN=

# JARVIS Desktop Companion for Blender/Photoshop/Premiere/etc.
# Required in hosted environments before a local computer may connect.
DESKTOP_BRIDGE_TOKEN=
DESKTOP_FRAME_MAX_BYTES=3000000
DESKTOP_FRAME_RETENTION=2

# Fuel/Lovable business API contract.
FUEL_API_BASE_URL=
FUEL_API_TOKEN=
FUEL_WEBHOOK_SECRET=

# Optional dedicated search providers. OpenAI hosted web search is the fallback.
TAVILY_API_KEY=
SERPER_API_KEY=

SECRETS_PATH=~/.config/jarvis/secrets.json
AUTONOMOUS_ROUTING=true
ALLOW_EXTERNAL_AI=true
ALLOW_LOCAL_FALLBACK=false
FINALIZE_WITH_PRIMARY=true
MAX_AGENT_STEPS=5
MAX_TASK_RETRIES=2
MAX_PLAN_TASKS=8
WORKSPACE_DIR=./workspace
ENABLE_AUTONOMY=true
ALLOW_MEDIUM_RISK_TOOLS=true

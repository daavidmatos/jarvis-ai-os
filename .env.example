APP_ENV=development
DATABASE_URL=sqlite:///./jarvis.db
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=

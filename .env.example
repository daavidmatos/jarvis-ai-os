APP_ENV=development
DATABASE_URL=sqlite:///./jarvis.db
REDIS_URL=redis://localhost:6379/0

# Configure once. OpenAI is then JARVIS' automatic primary intelligence.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
PRIMARY_PROVIDER=openai

# Optional specialist AIs. If configured, JARVIS may delegate automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# Optional search providers. OpenAI web search is the default fallback.
TAVILY_API_KEY=
SERPER_API_KEY=

AUTONOMOUS_ROUTING=true
ALLOW_EXTERNAL_AI=true
ALLOW_LOCAL_FALLBACK=false
MAX_AGENT_STEPS=5
MAX_TASK_RETRIES=2
MAX_PLAN_TASKS=8
WORKSPACE_DIR=./workspace
ENABLE_AUTONOMY=false
ALLOW_MEDIUM_RISK_TOOLS=true
